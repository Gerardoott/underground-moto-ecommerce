# ---------------------------------------------------------------------------
# Copiar a .env y completar. Nunca commitear el .env real.
# ---------------------------------------------------------------------------

# --- Base de datos (Medusa) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/underground_moto

# --- Redis (cache / event bus de Medusa) ---
REDIS_URL=redis://localhost:6379

# --- Medusa backend ---
MEDUSA_ADMIN_CORS=http://localhost:7000,http://localhost:7001
MEDUSA_STORE_CORS=http://localhost:8000
JWT_SECRET=cambiar-por-un-valor-aleatorio-largo
COOKIE_SECRET=cambiar-por-otro-valor-aleatorio-largo

# --- Storefront (Next.js) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=pe

# --- Pagos: Culqi (Fase 1 — Perú) ---
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# --- Pagos: Stripe (Fase 3 — internacional) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage de imágenes (Cloudflare R2 / S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Analítica / errores ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
